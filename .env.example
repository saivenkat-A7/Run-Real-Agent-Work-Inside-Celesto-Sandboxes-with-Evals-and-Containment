# Placeholders only. Copy to .env (never commit .env).
# local = open-source runtime (Linux+KVM / macOS). cloud = Celesto Cloud. Snapshots/network policy need local.
CELESTO_PROVIDER=local
CELESTO_API_KEY=replace-me
CELESTO_BACKEND=firecracker
CELESTO_SIZE=micro
CELESTO_NETWORK_MODE=on
LLM_BASE_URL=https://example-llm-host/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-with-a-model-name
DATABASE_URL=postgresql://ledger:ledger@ledger:5432/ledger
API_PORT=8080
LEDGER_API_URL=http://localhost:8080
ALLOWED_PACKAGES=python3
ALLOWED_HOSTS=
REPORTS_DIR=reports
LOG_DIR=logs
